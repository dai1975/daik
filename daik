def work_agent_run(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    config = load_site_config(root)
    workflow_path = root / ".agents/daik-workflow.yaml"
    if not workflow_path.is_file():
        raise DaikError(f"required workflow is missing: {workflow_path}")
    workflow = parse_yaml_subset(workflow_path)
    diagnostics = SiteValidator(root).validate()
    errors = [item for item in diagnostics if item.severity == "ERROR"]
    if errors:
        raise DaikError(
            "site validation failed before agent execution: "
            + "; ".join(f"{item.path}: {item.message}" for item in errors)
        )
    def emit(item: dict[str, Any]) -> None:
        print(json.dumps(item, ensure_ascii=False, sort_keys=True), flush=True)

    try:
        AgentRunner(root, config, workflow).run(args.issue, args.state, emit)
    except AgentExecutionError as error:
        print(f"Agent run failed: {error}", file=sys.stderr)
        return 1
    except RunnerError as error:
        raise DaikError(str(error)) from error
    return 0


def work_run(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    config = load_site_config(root)
    workflow_path = root / ".agents/daik-workflow.yaml"
    if not workflow_path.is_file():
        raise DaikError(f"required workflow is missing: {workflow_path}")
    workflow = parse_yaml_subset(workflow_path)
    diagnostics = SiteValidator(root).validate()
    errors = [item for item in diagnostics if item.severity == "ERROR"]
    if errors:
        raise DaikError(
            "site validation failed before broker execution: "
            + "; ".join(f"{item.path}: {item.message}" for item in errors)
        )
    tracker = config.get("tracker")
    joint_command = tracker.get("joint") if isinstance(tracker, dict) else None
    if not isinstance(joint_command, list) or not joint_command:
        raise DaikError("tracker.joint must configure a tracker joint command")
    joint_timeout = tracker.get("joint_timeout_seconds", 30)
    joint = TrackerJoint(root, joint_command, joint_timeout)
    try:
        run_log = BrokerRunLog(root, "run", 1)
        run_log.record("run.started", mode="run", issue=args.issue, concurrency=1)
        run_log.record("work.submitted", issue=args.issue)
    except BrokerRunError as error:
        raise DaikError(str(error)) from error

    def emit(item: dict[str, Any]) -> None:
        print(json.dumps(item, ensure_ascii=False, sort_keys=True), flush=True)
        run_log.record("work.event", issue=args.issue, event=item)

    try:
        final_state = Broker(root, config, workflow, joint).run(
            args.issue, emit, args.transition
        )
    except BrokerError as error:
        run_log.record("work.failed", issue=args.issue, attempts=1, error=str(error))
        run_log.finish("failed", error=str(error))
        print(f"Broker execution failed: {error}", file=sys.stderr)
        return 1
    except BrokerRunError as error:
        print(f"Broker logging failed: {error}", file=sys.stderr)
        return 1
    try:
        run_log.record("work.stopped", issue=args.issue, state=final_state, attempts=1)
        run_log.finish("completed", result_state=final_state)
    except BrokerRunError as error:
        print(f"Broker logging failed: {error}", file=sys.stderr)
        return 1
    print(json.dumps({"issue": args.issue, "state": final_state}, sort_keys=True))
    return 0


def work_watch(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    config = load_site_config(root)
    workflow_path = root / ".agents/daik-workflow.yaml"
    if not workflow_path.is_file():
        raise DaikError(f"required workflow is missing: {workflow_path}")
    workflow = parse_yaml_subset(workflow_path)
    diagnostics = SiteValidator(root).validate()
    errors = [item for item in diagnostics if item.severity == "ERROR"]
    if errors:
        raise DaikError(
            "site validation failed before broker watch: "
            + "; ".join(f"{item.path}: {item.message}" for item in errors)
        )
    tracker = config.get("tracker")
    joint_command = tracker.get("joint") if isinstance(tracker, dict) else None
    if not isinstance(joint_command, list) or not joint_command:
        raise DaikError("tracker.joint must configure a tracker joint command")
    joint = TrackerJoint(root, joint_command, tracker.get("joint_timeout_seconds", 30))
    agent = config["agent"]
    polling = config["polling"]

    try:
        run_log = BrokerRunLog(root, "watch", agent["max_concurrent_agents"])
        run_log.record(
            "run.started",
            mode="watch",
            concurrency=agent["max_concurrent_agents"],
            once=args.once,
        )
    except BrokerRunError as error:
        raise DaikError(str(error)) from error

    def emit(item: dict[str, Any]) -> None:
        record = run_log.append(item)
        print(json.dumps(record, ensure_ascii=False, sort_keys=True), flush=True)

    watcher = WorkWatcher(
        lambda: Broker(root, config, workflow, joint),
        joint,
        agent["max_concurrent_agents"],
        polling["interval_ms"],
        polling.get("max_retries", 3),
        polling.get("retry_initial_ms", 1000),
        agent["max_retry_backoff_ms"],
        emit,
    )
    try:
        result = watcher.run(once=args.once)
    except WatchError as error:
        run_log.record("run.failed", error=str(error))
        run_log.finish("failed", error=str(error))
        print(f"Broker watch failed: {error}", file=sys.stderr)
        return 1
    except BrokerRunError as error:
        print(f"Broker logging failed: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        run_log.record("run.interrupted")
        run_log.finish("interrupted")
        print("Broker watch stopped", file=sys.stderr)
        return 130
    status = "completed" if result == 0 else "failed"
    try:
        run_log.record("run.finished", status=status)
        run_log.finish(status)
    except BrokerRunError as error:
        print(f"Broker logging failed: {error}", file=sys.stderr)
        return 1
    return result


def work_status(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    try:
        status = broker_run_status(root, args.run)
    except BrokerRunError as error:
        raise DaikError(str(error)) from error
    if args.json:
        print(json.dumps(status, ensure_ascii=False, sort_keys=True))
        return 0
    print(f"Broker run: {status['broker_run_id']}")
    print(f"Mode: {status['mode']}")
    print(f"Status: {status['status']}")
    print(f"Started: {status['started_at']}")
    print(f"Finished: {status.get('finished_at') or '-'}")
    print(f"Concurrency: {status['concurrency']}")
    work = status["work"]
    if work:
        print()
        print("ISSUE\tSTATUS\tATTEMPT\tSTATE/ERROR")
        for item in work:
            detail = item.get("state") or item.get("error") or "-"
            print(
                f"{item['issue']}\t{item['status']}\t{item.get('attempts', item.get('attempt', '-'))}"
                f"\t{detail}"
            )
    return 0


def add_template_dir_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--template-dir",
        action="append",
        default=[],
        metavar="PATH",
        help="additional directory to search recursively for pack.yaml (repeatable)",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="daik",
        usage=(
            "%(prog)s [-h] [--version] <subcommand> ...\n"
            "       %(prog)s site <init | packs | validate | doctor> ...\n"
            "       %(prog)s work <run | watch | status | workspace | handoff | agent> ..."
        ),
        description="Issue-driven coding-agent workspace tools.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    subparsers = parser.add_subparsers(
        dest="command", required=True, metavar="<subcommand>"
    )
    site_parser = subparsers.add_parser("site", help="manage a development workspace")
    site_subparsers = site_parser.add_subparsers(dest="site_command", required=True)

    init_parser = site_subparsers.add_parser(
        "init", help="initialize the current development workspace from packs"
    )
    init_parser.add_argument("--root", default=".", help="workspace root (default: current directory)")
    init_parser.add_argument("--lang", choices=("ja", "en"), default="ja")
    init_parser.add_argument("--base", default="default", help=argparse.SUPPRESS)
    init_parser.add_argument("--workflow", default="standard", metavar="PACK")
    init_parser.add_argument("--tracker", default="github-issues", metavar="PACK")
    init_parser.add_argument(
        "--wet-run",
        action="store_true",
        help="write the previewed files (the default is preview-only)",
    )
    add_template_dir_argument(init_parser)
    init_parser.set_defaults(handler=init_workspace)

    packs_parser = site_subparsers.add_parser("packs", help="list available packs")
    packs_parser.add_argument("--lang", choices=("ja", "en"), default="ja")
    add_template_dir_argument(packs_parser)
    packs_parser.set_defaults(handler=list_packs)

    validate_parser = site_subparsers.add_parser(
        "validate", help="validate a site's local daik contract"
    )
    validate_parser.add_argument("--root", default=".", help="site root (default: current directory)")
    validate_parser.set_defaults(handler=validate_site)

    doctor_parser = site_subparsers.add_parser(
        "doctor", help="diagnose a site's local tools and runtime environment"
    )
    doctor_parser.add_argument("--root", default=".", help="site root (default: current directory)")
    doctor_parser.set_defaults(handler=doctor_site)

    work_parser = subparsers.add_parser("work", help="manage issue work and handoffs")
    work_subparsers = work_parser.add_subparsers(
        dest="work_command", required=True, metavar="<work-command>"
    )
    run_parser = work_subparsers.add_parser(
        "run", help="run the broker for one Issue until it stops or reaches a final state"
    )
    run_parser.add_argument("issue", metavar="ISSUE")
    run_parser.add_argument("--root", default=".", help="site root")
    run_parser.add_argument(
        "--transition",
        metavar="NAME",
        help="select a declared transition when resuming a human state",
    )
    run_parser.set_defaults(handler=work_run)
    watch_parser = work_subparsers.add_parser(
        "watch", help="poll ready Issues and run brokers concurrently"
    )
    watch_parser.add_argument("--root", default=".", help="site root")
    watch_parser.add_argument(
        "--once", action="store_true", help="poll once and wait for submitted work"
    )
    watch_parser.set_defaults(handler=work_watch)
    status_parser = work_subparsers.add_parser(
        "status", help="show local status for the latest broker run"
    )
    status_parser.add_argument("--root", default=".", help="site root")
    status_parser.add_argument("--run", metavar="RUN_ID", help="broker run ID")
    status_parser.add_argument("--json", action="store_true", help="write one JSON object")
    status_parser.set_defaults(handler=work_status)
    workspace_parser = work_subparsers.add_parser(
        "workspace", help="manage per-issue Git worktrees"
    )
    workspace_subparsers = workspace_parser.add_subparsers(
        dest="workspace_command", required=True, metavar="<workspace-command>"
    )

    def add_workspace_common(command_parser: argparse.ArgumentParser) -> None:
        command_parser.add_argument("issue", metavar="ISSUE")
        command_parser.add_argument("--root", default=".", help="site root")
        command_parser.add_argument(
            "--repo", action="append", default=[], metavar="NAME", help="repository to include"
        )

    create_parser = workspace_subparsers.add_parser("create", help="create or reuse worktrees")
    add_workspace_common(create_parser)
    create_parser.set_defaults(handler=work_workspace_create)

    show_parser = workspace_subparsers.add_parser("show", help="inspect local worktrees")
    add_workspace_common(show_parser)
    show_parser.set_defaults(handler=work_workspace_show)

    list_parser = workspace_subparsers.add_parser("list", help="list local workspace directories")
    list_parser.add_argument("--root", default=".", help="site root")
    list_parser.set_defaults(handler=work_workspace_list)

    reconcile_parser = workspace_subparsers.add_parser(
        "reconcile", help="compare local worktrees with a recorded issue event"
    )
    add_workspace_common(reconcile_parser)
    reconcile_parser.add_argument(
        "--event", required=True, metavar="PATH", help="recorded event JSON path, or - for stdin"
    )
    reconcile_parser.set_defaults(handler=work_workspace_reconcile)

    remove_parser = workspace_subparsers.add_parser("remove", help="remove worktrees, retaining branches")
    add_workspace_common(remove_parser)
    remove_parser.add_argument(
        "--wet-run", action="store_true", help="perform the previewed worktree removals"
    )
    remove_parser.set_defaults(handler=work_workspace_remove)

    handoff_parser = work_subparsers.add_parser("handoff", help="create agent handoff events")
    handoff_subparsers = handoff_parser.add_subparsers(
        dest="handoff_command", required=True, metavar="<handoff-command>"
    )
    handoff_create_parser = handoff_subparsers.add_parser(
        "create", help="emit a structured handoff event"
    )
    handoff_create_parser.add_argument("issue", metavar="ISSUE")
    handoff_create_parser.add_argument("--from", dest="from_role", required=True, metavar="ROLE")
    handoff_create_parser.add_argument("--to", dest="to_role", required=True, metavar="ROLE")
    handoff_create_parser.add_argument("--phase", required=True)
    handoff_create_parser.add_argument("--summary", required=True)
    handoff_create_parser.add_argument("--commit", action="append", default=[])
    handoff_create_parser.add_argument(
        "--validation", action="append", default=[], metavar="COMMAND=RESULT"
    )
    handoff_create_parser.add_argument("--decision", action="append", default=[])
    handoff_create_parser.add_argument("--risk", action="append", default=[])
    handoff_create_parser.add_argument("--next-action", action="append", default=[])
    handoff_create_parser.set_defaults(handler=work_handoff_create)

    agent_parser = work_subparsers.add_parser(
        "agent", help="run one coding-agent workflow state"
    )
    agent_subparsers = agent_parser.add_subparsers(
        dest="agent_command", required=True, metavar="<agent-command>"
    )
    agent_run_parser = agent_subparsers.add_parser(
        "run", help="invoke the configured coding agent for one state"
    )
    agent_run_parser.add_argument("issue", metavar="ISSUE")
    agent_run_parser.add_argument("--state", required=True, metavar="STATE")
    agent_run_parser.add_argument("--root", default=".", help="site root")
    agent_run_parser.set_defaults(handler=work_agent_run)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    arguments = sys.argv[1:] if argv is None else argv
    if not arguments:
        parser.print_help()
        return 0
    args = parser.parse_args(arguments)
    try:
        return args.handler(args)
    except DaikError as error:
        parser.error(str(error))
    except OSError as error:
        parser.error(str(error))
    return 2


if __name__ == "__main__":
    sys.exit(main())
