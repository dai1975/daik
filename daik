VERSION: Final = "0.14.2"
BUILTIN_TEMPLATES: Final = Path(__file__).resolve().parent / "templates"
PACK_FILE: Final = "pack.yaml"


class DaikError(Exception):
    """Expected command-line error."""


def positive_integer(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value > 0


@dataclass(frozen=True)
class Diagnostic:
    severity: str
    path: str
    message: str


@dataclass(frozen=True)
class Pack:
    path: Path
    data: dict[str, Any]

    @property
    def id(self) -> str:
        return require_string(self.data, "id", self.path)

    @property
    def kind(self) -> str:
        return require_string(self.data, "kind", self.path)

    @property
    def key(self) -> str:
        value = self.data.get("key")
        return value if isinstance(value, str) else self.id.rsplit(".", 1)[-1]


def parse_scalar(value: str, source: Path, line_number: int) -> Any:
    if not value:
        return None
    if value.startswith('"'):
        try:
            return json.loads(value)
        except json.JSONDecodeError as error:
            raise DaikError(f"{source}:{line_number}: invalid quoted value") from error
    if value.startswith("'"):
        if not value.endswith("'") or len(value) < 2:
            raise DaikError(f"{source}:{line_number}: invalid quoted value")
        return value[1:-1].replace("''", "'")
    if value in {"true", "false"}:
        return value == "true"
    if value in {"null", "~"}:
        return None
    try:
        return int(value)
    except ValueError:
        return value


def parse_yaml_subset_text(content: str, source: Path) -> dict[str, Any]:
    """Parse the dependency-free YAML subset used by daik documents."""
    logical_lines: list[tuple[int, int, str]] = []
    physical_lines = content.splitlines()
    index = 0
    while index < len(physical_lines):
        raw_line = physical_lines[index]
        line_number = index + 1
        if "\t" in raw_line:
            raise DaikError(f"{source}:{line_number}: tabs are not allowed")
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            index += 1
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        text = raw_line[indent:]
        if ":" in text and text.split(":", 1)[1].strip() in {"|", "|-", "|+"}:
            key = text.split(":", 1)[0].strip()
            block_lines: list[str] = []
            index += 1
            block_indent: int | None = None
            while index < len(physical_lines):
                block_line = physical_lines[index]
                if "\t" in block_line:
                    raise DaikError(f"{source}:{index + 1}: tabs are not allowed")
                if block_line.strip():
                    current_indent = len(block_line) - len(block_line.lstrip(" "))
                    if current_indent <= indent:
                        break
                    if block_indent is None:
                        block_indent = current_indent
                    block_lines.append(block_line[min(block_indent, len(block_line)) :])
                else:
                    block_lines.append("")
                index += 1
            value = "\n".join(block_lines)
            if text.split(":", 1)[1].strip() != "|-":
                value += "\n"
            logical_lines.append((line_number, indent, f"{key}: {json.dumps(value)}"))
            continue
        logical_lines.append((line_number, indent, raw_line[indent:]))
        index += 1

    if not logical_lines:
        raise DaikError(f"empty YAML document: {source}")

    def parse_block(index: int, indent: int) -> tuple[Any, int]:
        if index >= len(logical_lines):
            return {}, index
        is_list = logical_lines[index][2].startswith("- ")
        result: Any = [] if is_list else {}

        while index < len(logical_lines):
            line_number, current_indent, text = logical_lines[index]
            if current_indent < indent:
                break
            if current_indent > indent:
                raise DaikError(f"{source}:{line_number}: unexpected indentation")

            if is_list:
                if not text.startswith("- "):
                    raise DaikError(f"{source}:{line_number}: mixed list and mapping")
                item = text[2:].strip()
                if not item:
                    raise DaikError(
                        f"{source}:{line_number}: lists must contain scalar values"
                    )
                result.append(parse_scalar(item, source, line_number))
                index += 1
                continue

            if text.startswith("- ") or ":" not in text:
                raise DaikError(f"{source}:{line_number}: expected a mapping entry")
            key, raw_value = text.split(":", 1)
            key = key.strip()
            if not key or key in result:
                raise DaikError(f"{source}:{line_number}: invalid or duplicate key")
            raw_value = raw_value.strip()
            index += 1
            if raw_value:
                result[key] = parse_scalar(raw_value, source, line_number)
            elif index < len(logical_lines) and logical_lines[index][1] > indent:
                child_indent = logical_lines[index][1]
                result[key], index = parse_block(index, child_indent)
            else:
                result[key] = {}
        return result, index

    parsed, final_index = parse_block(0, logical_lines[0][1])
    if final_index != len(logical_lines) or not isinstance(parsed, dict):
        raise DaikError(f"YAML document root must be a mapping: {source}")
    return parsed


def parse_yaml_subset(path: Path) -> dict[str, Any]:
    return parse_yaml_subset_text(path.read_text(encoding="utf-8"), path)


def require_string(data: dict[str, Any], key: str, source: Path) -> str:
    value = data.get(key)
    if not isinstance(value, str) or not value.strip():
        raise DaikError(f"{source}: {key} must be a non-empty string")
    return value


def string_list(data: dict[str, Any], key: str, source: Path) -> list[str]:
    value = data.get(key, [])
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise DaikError(f"{source}: {key} must be a list of strings")
    return value


def mapping(data: dict[str, Any], key: str, source: Path) -> dict[str, Any]:
    value = data.get(key, {})
    if not isinstance(value, dict):
        raise DaikError(f"{source}: {key} must be a mapping")
    return value


def validate_pack(pack: Pack) -> None:
    if pack.data.get("schema_version") != 1:
        raise DaikError(f"{pack.path}: unsupported schema_version")
    if pack.kind not in {"base", "workflow", "tracker"}:
        raise DaikError(f"{pack.path}: unsupported pack kind: {pack.kind}")
    if not isinstance(pack.data.get("version"), int):
        raise DaikError(f"{pack.path}: version must be an integer")
    languages = string_list(pack.data, "languages", pack.path)
    if not languages:
        raise DaikError(f"{pack.path}: languages must not be empty")
    string_list(pack.data, "requires", pack.path)
    string_list(pack.data, "provides", pack.path)
    mapping(pack.data, "contributions", pack.path)
    mapping(pack.data, "files_user", pack.path)
    mapping(pack.data, "files_daik", pack.path)
    daik_config = pack.data.get("daik_config")
    if daik_config is not None and not isinstance(daik_config, str):
        raise DaikError(f"{pack.path}: daik_config must be a path string")


def template_roots(extra_roots: list[str]) -> list[Path]:
    roots = [BUILTIN_TEMPLATES]
    roots.extend(Path(value).expanduser().resolve() for value in extra_roots)
    unique: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        resolved = root.resolve()
        if resolved in seen:
            continue
        if not resolved.is_dir():
            raise DaikError(f"template directory is not a directory: {resolved}")
        seen.add(resolved)
        unique.append(resolved)
    return unique


def discover_packs(roots: list[Path]) -> dict[str, Pack]:
    packs: dict[str, Pack] = {}
    for root in roots:
        for manifest in sorted(root.rglob(PACK_FILE)):
            relative_parts = manifest.relative_to(root).parts
            if any(part == ".git" or part.startswith(".") for part in relative_parts):
                continue
            pack = Pack(manifest.parent.resolve(), parse_yaml_subset(manifest))
            validate_pack(pack)
            if pack.id in packs:
                raise DaikError(
                    f"duplicate pack id {pack.id}: {packs[pack.id].path} and {pack.path}"
                )
            packs[pack.id] = pack
    if not packs:
        raise DaikError("no daik packs found")
    return packs


def select_pack(packs: dict[str, Pack], kind: str, selector: str) -> Pack:
    candidates = [
        pack
        for pack in packs.values()
        if pack.kind == kind and selector in {pack.id, pack.key}
    ]
    if not candidates:
        available = ", ".join(sorted(pack.key for pack in packs.values() if pack.kind == kind))
        raise DaikError(f"unknown {kind} pack {selector!r}; available: {available or '(none)'}")
    if len(candidates) > 1:
        ids = ", ".join(sorted(pack.id for pack in candidates))
        raise DaikError(f"ambiguous {kind} pack {selector!r}; use one of: {ids}")
    return candidates[0]


def localized_name(pack: Pack, language: str) -> str:
    names = mapping(pack.data, "name", pack.path)
    value = names.get(language, names.get("en", pack.key))
    return value if isinstance(value, str) else pack.key


def localized_file(pack: Pack, values: Any, language: str, label: str) -> Path:
    if not isinstance(values, dict):
        raise DaikError(f"{pack.path}: {label} must map languages to files")
    selected_language = language if language in values else "en"
    if selected_language not in values:
        raise DaikError(f"{pack.path}: {label} has no {language} or en variant")
    if selected_language != language:
        print(f"Warning: {pack.id} has no {language} {label}; using English", file=sys.stderr)
    relative = values[selected_language]
    if not isinstance(relative, str):
        raise DaikError(f"{pack.path}: {label}.{selected_language} must be a path")
    return safe_pack_source(pack, relative)


def safe_pack_source(pack: Pack, relative_name: str) -> Path:
    relative = Path(relative_name)
    if relative.is_absolute():
        raise DaikError(f"{pack.path}: source path must be relative: {relative_name}")
    resolved = (pack.path / relative).resolve()
    try:
        resolved.relative_to(pack.path)
    except ValueError as error:
        raise DaikError(f"{pack.path}: source escapes pack: {relative_name}") from error
    if not resolved.is_file():
        raise DaikError(f"{pack.path}: source file not found: {relative_name}")
    return resolved


def safe_target_name(relative_name: str, source: Path) -> str:
    relative = Path(relative_name)
    if relative.is_absolute() or ".." in relative.parts or relative == Path("."):
        raise DaikError(f"{source}: invalid target path: {relative_name}")
    return relative.as_posix()


def read_contributions(packs: list[Pack], slot: str, language: str) -> list[str]:
    contents: list[str] = []
    for pack in packs:
        contributions = mapping(pack.data, "contributions", pack.path)
        if slot not in contributions:
            continue
        source = localized_file(pack, contributions[slot], language, f"contributions.{slot}")
        contents.append(source.read_text(encoding="utf-8").strip())
    return [content for content in contents if content]


def read_static_files(packs: list[Pack]) -> dict[str, tuple[str, str]]:
    files: dict[str, tuple[str, str]] = {}
    for pack in packs:
        for manifest_key, owner in (("files_user", "user"), ("files_daik", "daik")):
            entries = mapping(pack.data, manifest_key, pack.path)
            for source_name, target_name in entries.items():
                if not isinstance(target_name, str):
                    raise DaikError(f"{pack.path}: {manifest_key} targets must be strings")
                source = safe_pack_source(pack, source_name)
                target = safe_target_name(target_name, pack.path)
                content = source.read_text(encoding="utf-8")
                if target in files and files[target][1] != content:
                    raise DaikError(f"selected packs provide conflicting target: {target}")
                files[target] = (owner, content)
    return files


def read_daik_config(packs: list[Pack]) -> str:
    fragments: list[str] = []
    for pack in packs:
        source_name = pack.data.get("daik_config")
        if source_name is None:
            continue
        source = safe_pack_source(pack, source_name)
        content = source.read_text(encoding="utf-8").strip()
        if content:
            fragments.append(content)
    if not fragments:
        raise DaikError("selected packs do not provide daik configuration")
    return "\n\n".join(fragments) + "\n"


def sha256_text(content: str) -> str:
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
    )
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        temporary_path.replace(path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def safe_workspace_target(root: Path, relative_name: str) -> Path:
    relative = Path(safe_target_name(relative_name, root))
    current = root
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise DaikError(f"target path contains a symlink: {relative_name}")
    return root / relative


def build_templates(selected: list[Pack], language: str) -> dict[str, tuple[str, str]]:
    templates = read_static_files(selected)
    templates[".agents/daik-config.yaml"] = ("user", read_daik_config(selected))
    agents_parts = read_contributions(selected, "agents", language)
    workflow_parts = read_contributions(selected, "workflow", language)
    tracker_parts = read_contributions(selected, "tracker", language)
    internal_parts = read_contributions(selected, "internal", language)
    worker_parts = read_contributions(selected, "worker", language)
    if not agents_parts:
        raise DaikError("selected packs do not provide AGENTS.md instructions")
    if not workflow_parts:
        raise DaikError("selected packs do not provide a workflow")
    if not tracker_parts:
        raise DaikError("selected packs do not provide tracker instructions")
    if not internal_parts:
        raise DaikError("selected packs do not provide internal-area instructions")
    if not worker_parts:
        raise DaikError("selected packs do not provide worker instructions")

    templates[".daik/daik-AGENTS.md.template"] = (
        "daik",
        "\n\n".join(agents_parts).rstrip() + "\n",
    )
    templates[".daik/AGENTS.md"] = (
        "daik",
        "\n\n".join(internal_parts).rstrip() + "\n",
    )
    templates[".agents/daik-worker.md"] = (
        "user",
        "\n\n".join(worker_parts).rstrip() + "\n",
    )
    workflow = selected[1]
    tracker = selected[2]
    actions = string_list(workflow.data, "requires", workflow.path)
    workflow_header_lines = [
        "daik:",
        "  schema_version: 1",
        "  artifact: workflow",
        "  ownership: user",
        "  user_action: review-and-customize",
        f"  language: {json.dumps(language)}",
        f"  workflow_pack: {json.dumps(workflow.id)}",
        f"  tracker_pack: {json.dumps(tracker.id)}",
        '  tracker_instructions: ".agents/daik-tracker.md"',
        "  issue_actions:",
        *(f"    - {json.dumps(action)}" for action in actions),
        "",
    ]
    workflow_header = "\n".join(workflow_header_lines) + "\n"
    if len(workflow_parts) != 1:
        raise DaikError("selected workflow must provide exactly one YAML document")
    workflow_content = workflow_header + workflow_parts[0].rstrip() + "\n"
    parse_yaml_subset_text(workflow_content, workflow.path / "generated-workflow.yaml")
    templates[".agents/daik-workflow.yaml"] = (
        "user",
        workflow_content,
    )
    tracker_actions = string_list(tracker.data, "provides", tracker.path)
    tracker_header_lines = [
        "---",
        "daik:",
        "  schema_version: 1",
        "  artifact: tracker",
        "  ownership: user",
        "  user_action: review-and-customize",
        f"  language: {json.dumps(language)}",
        f"  tracker_pack: {json.dumps(tracker.id)}",
        "  provides:",
        *(f"    - {json.dumps(action)}" for action in tracker_actions),
        "---",
        "",
    ]
    tracker_header = "\n".join(tracker_header_lines) + "\n"
    templates[".agents/daik-tracker.md"] = (
        "user",
        tracker_header + "\n\n".join(tracker_parts).rstrip() + "\n",
    )
    return templates


def check_existing_selection(root: Path, selected: list[Pack], language: str) -> None:
    manifest_path = safe_workspace_target(root, ".daik/manifest.json")
    if not manifest_path.exists():
        return
    if not manifest_path.is_file():
        raise DaikError("expected a file but found another file type: .daik/manifest.json")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        previous_ids = [item["id"] for item in manifest["packs"]]
        previous_language = manifest["language"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise DaikError("cannot read pack selection from .daik/manifest.json") from error
    selected_ids = [pack.id for pack in selected]
    if previous_ids != selected_ids or previous_language != language:
        raise DaikError(
            "site is already initialized with a different language or pack selection; "
            "daik does not replace user-owned files"
        )


def init_workspace(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    root_missing = not root.exists()
    if not root_missing and not root.is_dir():
        raise DaikError(f"workspace root is not a directory: {root}")

    packs = discover_packs(template_roots(args.template_dir))
    selected = [
        select_pack(packs, "base", args.base),
        select_pack(packs, "workflow", args.workflow),
        select_pack(packs, "tracker", args.tracker),
    ]
    workflow, tracker = selected[1], selected[2]
    missing = sorted(
        set(string_list(workflow.data, "requires", workflow.path))
        - set(string_list(tracker.data, "provides", tracker.path))
    )
    if missing:
        raise DaikError(
            f"workflow {workflow.id} requires capabilities not provided by "
            f"{tracker.id}: {', '.join(missing)}"
        )

    templates = build_templates(selected, args.lang)
    if root_missing and args.wet_run:
        try:
            root.mkdir(parents=True)
        except OSError as error:
            raise DaikError(f"could not create workspace root {root}: {error}") from error
    if args.wet_run:
        check_existing_selection(root, selected, args.lang)
    records: dict[str, dict[str, str]] = {}
    created: list[str] = []
    existing: list[str] = []
    pending_writes: list[tuple[Path, str]] = []

    for relative_name, (owner, content) in sorted(templates.items()):
        target = safe_workspace_target(root, relative_name)
        template_hash = sha256_text(content)
        if target.exists():
            if not target.is_file():
                raise DaikError(f"expected a file but found another file type: {relative_name}")
            existing.append(relative_name)
            current_hash = sha256_file(target)
            state = "unchanged" if current_hash == template_hash else "modified"
        else:
            created.append(relative_name)
            current_hash = template_hash
            state = "created"
            pending_writes.append((target, content))
        records[relative_name] = {
            "owner": owner,
            "state": state,
            "template_sha256": template_hash,
            "current_sha256": current_hash,
        }

    workspaces = safe_workspace_target(root, "workspaces")
    if workspaces.exists() and not workspaces.is_dir():
        raise DaikError("expected a directory but found another file type: workspaces")
    workspace_created = not workspaces.exists()

    manifest_name = ".daik/manifest.json"
    manifest = {
        "schema_version": 1,
        "tool": "daik",
        "tool_version": VERSION,
        "document": {
            "artifact": "manifest",
            "ownership": "daik",
            "user_action": "none",
        },
        "language": args.lang,
        "packs": [
            {
                "id": pack.id,
                "kind": pack.kind,
                "version": pack.data["version"],
                "source": str(pack.path),
            }
            for pack in selected
        ],
        "files": records,
    }
    manifest_content = json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    manifest_path = safe_workspace_target(root, manifest_name)
    manifest_existed = manifest_path.exists()
    if manifest_existed and not manifest_path.is_file():
        raise DaikError(f"expected a file but found another file type: {manifest_name}")
    if args.wet_run:
        for target, content in pending_writes:
            atomic_write(target, content)
        if workspace_created:
            workspaces.mkdir(parents=True)
        atomic_write(manifest_path, manifest_content)

    print("Selected packs:")
    for pack in selected:
        print(f"  {pack.kind}: {pack.id}")
    action = "Created" if args.wet_run else "Would create"
    if root_missing:
        print(f"{action} site root: {root}")
    for relative_name in created:
        print(f"{action}: {relative_name}")
    for relative_name in existing:
        print(f"Kept: {relative_name}")
    print(f"{action}: workspaces/" if workspace_created else "Kept: workspaces/")
    if args.wet_run:
        print(f"{'Updated' if manifest_existed else 'Created'}: {manifest_name}")
    else:
        print(f"Would write: {manifest_name}")
    print("Not modified: AGENTS.md")
    if not args.wet_run:
        print("Preview only: run again with --wet-run to apply these changes")
    else:
        print("Next: copy the tagged block from .daik/daik-AGENTS.md.template to AGENTS.md")
    if args.wet_run:
        print("Next: replace <<DAIK:SITE_GUIDE>> in the copied AGENTS.md block")
        print("Next: review .agents/daik-config.yaml")
        print("Next: review .agents/daik-workflow.yaml")
        print("Next: review .agents/daik-tracker.md and replace <<DAIK:TRACKER_TOOL>>")
    return 0


def list_packs(args: argparse.Namespace) -> int:
    packs = discover_packs(template_roots(args.template_dir))
    for kind in ("base", "workflow", "tracker"):
        print(f"{kind}:")
        candidates = sorted(
            (pack for pack in packs.values() if pack.kind == kind), key=lambda pack: pack.id
        )
        for pack in candidates:
            languages = ",".join(string_list(pack.data, "languages", pack.path))
            print(f"  {pack.id} ({languages}) - {localized_name(pack, args.lang)}")
    return 0


class SiteValidator:
    def __init__(self, root: Path):
        self.root = root
        self.diagnostics: list[Diagnostic] = []

    def report(self, severity: str, path: str, message: str) -> None:
        self.diagnostics.append(Diagnostic(severity, path, message))

    def load_text(self, relative: str) -> str | None:
        path = self.root / relative
        if not path.is_file():
            self.report("ERROR", relative, "required file is missing")
            return None
        try:
            return path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            self.report("ERROR", relative, f"cannot read file: {error}")
            return None

    def load_yaml(self, relative: str) -> dict[str, Any] | None:
        content = self.load_text(relative)
        if content is None:
            return None
        try:
            return parse_yaml_subset_text(content, Path(relative))
        except DaikError as error:
            self.report("ERROR", relative, str(error))
            return None

    def load_front_matter(self, relative: str) -> tuple[dict[str, Any], str] | None:
        content = self.load_text(relative)
        if content is None:
            return None
        lines = content.splitlines()
        if not lines or lines[0].strip() != "---":
            self.report("ERROR", relative, "missing YAML front matter")
            return None
        try:
            end = next(index for index, line in enumerate(lines[1:], 1) if line.strip() == "---")
        except StopIteration:
            self.report("ERROR", relative, "unterminated YAML front matter")
            return None
        try:
            metadata = parse_yaml_subset_text("\n".join(lines[1:end]), Path(relative))
        except DaikError as error:
            self.report("ERROR", relative, str(error))
            return None
        return metadata, "\n".join(lines[end + 1 :])

    def document_metadata(
        self, relative: str, artifact: str, ownership: str, user_action: str
    ) -> tuple[dict[str, Any], str] | None:
        loaded = self.load_front_matter(relative)
        if loaded is None:
            return None
        root, body = loaded
        metadata = root.get("daik")
        if not isinstance(metadata, dict):
            self.report("ERROR", relative, "front matter must contain a daik mapping")
            return None
        expected = {
            "schema_version": 1,
            "artifact": artifact,
            "ownership": ownership,
            "user_action": user_action,
        }
        for key, value in expected.items():
            if metadata.get(key) != value:
                self.report("ERROR", relative, f"daik.{key} must be {value!r}")
        return metadata, body

    def check_placeholders(self, relative: str, content: str) -> None:
        if "<<DAIK:" in content:
            self.report("ERROR", relative, "contains an unresolved <<DAIK:...>> placeholder")

    def validate_workflow(self, root: dict[str, Any]) -> dict[str, Any]:
        relative = ".agents/daik-workflow.yaml"
        metadata = root.get("daik")
        expected = {
            "schema_version": 1,
            "artifact": "workflow",
            "ownership": "user",
            "user_action": "review-and-customize",
        }
        if not isinstance(metadata, dict):
            self.report("ERROR", relative, "daik must be a mapping")
            metadata = {}
        for key, value in expected.items():
            if metadata.get(key) != value:
                self.report("ERROR", relative, f"daik.{key} must be {value!r}")

        if root.get("api_version") != "daik.dev/v1alpha1":
            self.report("ERROR", relative, "api_version must be 'daik.dev/v1alpha1'")
        if root.get("kind") != "coding-workflow":
            self.report("ERROR", relative, "kind must be 'coding-workflow'")
        limits = root.get("limits")
        if not isinstance(limits, dict) or not positive_integer(limits.get("max_transitions")):
            self.report("ERROR", relative, "limits.max_transitions must be a positive integer")

        profiles = root.get("agents")
        if not isinstance(profiles, dict):
            self.report("ERROR", relative, "agents must be a mapping")
            profiles = {}
        else:
            for name, profile in profiles.items():
                if not isinstance(profile, dict):
                    self.report("ERROR", relative, f"agents.{name} must be a mapping")
                    continue
                for key in ("role", "instructions"):
                    if not isinstance(profile.get(key), str) or not profile[key].strip():
                        self.report("ERROR", relative, f"agents.{name}.{key} must be a non-empty string")

        states = root.get("states")
        if not isinstance(states, dict) or not states:
            self.report("ERROR", relative, "states must be a non-empty mapping")
            return metadata
        if not isinstance(limits, dict) or not isinstance(limits.get("on_limit"), str):
            self.report("ERROR", relative, "limits.on_limit must name an existing state")
        elif limits["on_limit"] not in states:
            self.report("ERROR", relative, "limits.on_limit must name an existing state")
        initial = root.get("initial")
        if not isinstance(initial, str) or initial not in states:
            self.report("ERROR", relative, "initial must name an existing state")

        edges: dict[str, set[str]] = {str(name): set() for name in states}
        outcomes: set[str] = set()
        for name, state in states.items():
            prefix = f"states.{name}"
            if not isinstance(state, dict):
                self.report("ERROR", relative, f"{prefix} must be a mapping")
                continue
            state_type = state.get("type")
            if state_type not in {"agent", "program", "human", "final"}:
                self.report(
                    "ERROR", relative, f"{prefix}.type must be agent, program, human, or final"
                )
                continue
            if state_type == "final":
                outcome = state.get("outcome")
                if outcome not in {"success", "failure", "cancelled"}:
                    self.report("ERROR", relative, f"{prefix}.outcome must be success, failure, or cancelled")
                else:
                    outcomes.add(outcome)
                if "transitions" in state:
                    self.report("ERROR", relative, f"{prefix} final state must not define transitions")
                continue

            if state_type == "agent":
                profile = state.get("agent")
                if not isinstance(profile, str) or profile not in profiles:
                    self.report("ERROR", relative, f"{prefix}.agent must reference an agents entry")
                if not isinstance(state.get("task"), str) or not state["task"].strip():
                    self.report("ERROR", relative, f"{prefix}.task must be a non-empty string")
                if not positive_integer(state.get("max_visits")):
                    self.report("ERROR", relative, f"{prefix}.max_visits must be a positive integer")
                for handler in ("on_error", "on_limit"):
                    value = state.get(handler)
                    if not isinstance(value, dict) or not isinstance(value.get("to"), str):
                        self.report("ERROR", relative, f"{prefix}.{handler}.to is required")
                    elif value["to"] not in states:
                        self.report("ERROR", relative, f"{prefix}.{handler}.to names an unknown state")
                    else:
                        edges[str(name)].add(value["to"])
            elif state_type == "program":
                command = state.get("command")
                if (
                    not isinstance(command, list)
                    or not command
                    or not all(isinstance(item, str) and item for item in command)
                ):
                    self.report(
                        "ERROR", relative, f"{prefix}.command must be a non-empty argv list"
                    )
                if not isinstance(state.get("repository"), str) or not state["repository"]:
                    self.report(
                        "ERROR", relative, f"{prefix}.repository must be a non-empty string"
                    )
                if not positive_integer(state.get("timeout_seconds")):
                    self.report(
                        "ERROR", relative, f"{prefix}.timeout_seconds must be a positive integer"
                    )
            elif not isinstance(state.get("prompt"), str) or not state["prompt"].strip():
                self.report("ERROR", relative, f"{prefix}.prompt must be a non-empty string")

            transitions = state.get("transitions")
            if not isinstance(transitions, dict) or not transitions:
                self.report("ERROR", relative, f"{prefix}.transitions must be a non-empty mapping")
                continue
            otherwise_count = 0
            for transition_name, transition in transitions.items():
                item = f"{prefix}.transitions.{transition_name}"
                if not isinstance(transition, dict):
                    self.report("ERROR", relative, f"{item} must be a mapping")
                    continue
                target = transition.get("to")
                if not isinstance(target, str) or target not in states:
                    self.report("ERROR", relative, f"{item}.to must name an existing state")
                else:
                    edges[str(name)].add(target)
                if state_type == "program":
                    if set(transition) != {"to"}:
                        self.report(
                            "ERROR", relative, f"{item} may contain only to for a program state"
                        )
                    continue
                has_when = isinstance(transition.get("when"), str) and bool(transition["when"].strip())
                has_otherwise = transition.get("otherwise") is True
                if has_when == has_otherwise:
                    self.report("ERROR", relative, f"{item} must define exactly one of when or otherwise: true")
                otherwise_count += int(has_otherwise)
            if state_type == "program" and set(transitions) != {"succeeded", "failed", "error"}:
                self.report(
                    "ERROR",
                    relative,
                    f"{prefix}.transitions must define exactly succeeded, failed, and error",
                )
            elif state_type != "program" and otherwise_count != 1:
                self.report("ERROR", relative, f"{prefix}.transitions must contain exactly one otherwise fallback")

        for outcome in ("success", "failure", "cancelled"):
            if outcome not in outcomes:
                self.report("ERROR", relative, f"workflow must define a final state with outcome {outcome}")
        if isinstance(initial, str) and initial in states:
            reachable: set[str] = set()
            pending = [initial]
            while pending:
                name = pending.pop()
                if name in reachable:
                    continue
                reachable.add(name)
                pending.extend(edges.get(name, set()) - reachable)
            for name in sorted(set(states) - reachable):
                self.report("ERROR", relative, f"state {name!r} is unreachable from initial")
        return metadata

    def validate(self) -> list[Diagnostic]:
        manifest_text = self.load_text(".daik/manifest.json")
        manifest: dict[str, Any] | None = None
        if manifest_text is not None:
            try:
                value = json.loads(manifest_text)
                if not isinstance(value, dict):
                    raise ValueError("root must be an object")
                manifest = value
            except (json.JSONDecodeError, ValueError) as error:
                self.report("ERROR", ".daik/manifest.json", f"invalid JSON: {error}")

        workflow_document = self.load_yaml(".agents/daik-workflow.yaml")
        workflow_meta = self.validate_workflow(workflow_document) if workflow_document else {}
        tracker = self.document_metadata(
            ".agents/daik-tracker.md", "tracker", "user", "review-and-customize"
        )
        self.document_metadata(
            ".agents/daik-worker.md", "worker-policy", "user", "review-and-customize"
        )
        self.document_metadata(
            ".agents/daik-workflow-spec.md", "workflow-spec", "daik", "reference"
        )
        self.document_metadata(
            ".agents/daik-issue-event-spec.md", "issue-event-spec", "daik", "reference"
        )
        self.document_metadata(
            ".agents/daik-agent-context-spec.md", "agent-context-spec", "daik", "reference"
        )
        self.document_metadata(
            ".agents/daik-tracker-joint-spec.md", "tracker-joint-spec", "daik", "reference"
        )
        config = self.load_yaml(".agents/daik-config.yaml")
        agents = self.load_text("AGENTS.md")

        if agents is not None:
            self.check_placeholders("AGENTS.md", agents)
            for reference in (
                ".agents/daik-workflow.yaml",
                ".agents/daik-tracker.md",
                ".agents/daik-worker.md",
            ):
                if reference not in agents:
                    self.report("ERROR", "AGENTS.md", f"does not reference {reference}")
        for relative in (".agents/daik-workflow.yaml", ".agents/daik-tracker.md"):
            path = self.root / relative
            if path.is_file():
                self.check_placeholders(relative, path.read_text(encoding="utf-8"))

        tracker_meta = tracker[0] if tracker else {}
        actions = workflow_meta.get("issue_actions")
        provides = tracker_meta.get("provides")
        for relative, key, value in (
            (".agents/daik-workflow.yaml", "issue_actions", actions),
            (".agents/daik-tracker.md", "provides", provides),
        ):
            if not isinstance(value, list) or not value or not all(
                isinstance(item, str) and item for item in value
            ):
                self.report("ERROR", relative, f"daik.{key} must be a non-empty list of strings")
        if isinstance(actions, list) and isinstance(provides, list):
            missing = sorted(set(actions) - set(provides))
            if missing:
                self.report(
                    "ERROR",
                    ".agents/daik-tracker.md",
                    "does not provide workflow actions: " + ", ".join(missing),
                )

        if workflow_meta and tracker_meta:
            if workflow_meta.get("tracker_pack") != tracker_meta.get("tracker_pack"):
                self.report(
                    "ERROR",
                    ".agents/daik-workflow.yaml",
                    "daik.tracker_pack does not match the tracker document",
                )
            if workflow_meta.get("tracker_instructions") != ".agents/daik-tracker.md":
                self.report(
                    "ERROR",
                    ".agents/daik-workflow.yaml",
                    "daik.tracker_instructions must reference .agents/daik-tracker.md",
                )

        if config is not None:
            self.validate_config(config)
            repositories = config.get("repositories")
            states = workflow_document.get("states") if workflow_document else None
            if isinstance(repositories, dict) and isinstance(states, dict):
                for name, state in states.items():
                    if (
                        isinstance(state, dict)
                        and state.get("type") == "program"
                        and state.get("repository") not in repositories
                    ):
                        self.report(
                            "ERROR",
                            ".agents/daik-workflow.yaml",
                            f"states.{name}.repository must reference a configured repository",
                        )
            tracker_config = config.get("tracker")
            if (
                tracker_meta
                and isinstance(tracker_config, dict)
                and tracker_config.get("pack") != tracker_meta.get("tracker_pack")
            ):
                self.report(
                    "ERROR",
                    ".agents/daik-config.yaml",
                    "tracker.pack does not match the tracker document",
                )
        if manifest is not None:
            self.validate_manifest(manifest, workflow_meta, tracker_meta)

        workspace_root = None
        if isinstance(config, dict):
            workspace = config.get("workspace")
            if isinstance(workspace, dict):
                workspace_root = workspace.get("root")
        if isinstance(workspace_root, str):
            relative = Path(workspace_root)
            if not relative.is_absolute() and ".." not in relative.parts:
                target = self.root / relative
                if not target.is_dir():
                    self.report("ERROR", workspace_root, "configured workspace directory is missing")
        return self.diagnostics

    def validate_config(self, config: dict[str, Any]) -> None:
        relative = ".agents/daik-config.yaml"
        document = config.get("daik_document")
        expected = {
            "schema_version": 1,
            "artifact": "config",
            "ownership": "user",
            "user_action": "review-and-customize",
        }
        if not isinstance(document, dict):
            self.report("ERROR", relative, "daik_document must be a mapping")
        else:
            for key, value in expected.items():
                if document.get(key) != value:
                    self.report("ERROR", relative, f"daik_document.{key} must be {value!r}")
        if config.get("version") != 1:
            self.report("ERROR", relative, "version must be 1")
        workspace = config.get("workspace")
        root = workspace.get("root") if isinstance(workspace, dict) else None
        if not isinstance(root, str) or not root or Path(root).is_absolute() or ".." in Path(root).parts:
            self.report("ERROR", relative, "workspace.root must be a safe relative path")
        if isinstance(workspace, dict):
            branch_prefix = workspace.get("branch_prefix")
            if (
                not isinstance(branch_prefix, str)
                or not branch_prefix
                or "/" in branch_prefix
            ):
                self.report(
                    "ERROR", relative, "workspace.branch_prefix must be a non-empty path component"
                )
            if workspace.get("cleanup") not in {"manual"}:
                self.report("ERROR", relative, "workspace.cleanup must currently be 'manual'")
        repositories = config.get("repositories")
        if not isinstance(repositories, dict):
            self.report("ERROR", relative, "repositories must be a mapping")
        elif not repositories:
            self.report("WARNING", relative, "no workspace repositories are configured")
        else:
            for name, settings in repositories.items():
                if (
                    not isinstance(name, str)
                    or not name
                    or Path(name).name != name
                    or name in {".", ".."}
                    or not isinstance(settings, dict)
                ):
                    self.report("ERROR", relative, "each repository must be a named mapping")
                    continue
                path_value = settings.get("path")
                if (
                    not isinstance(path_value, str)
                    or not path_value
                    or Path(path_value).is_absolute()
                    or ".." in Path(path_value).parts
                ):
                    self.report(
                        "ERROR", relative, f"repositories.{name}.path must be a safe relative path"
                    )
                base = settings.get("base", "HEAD")
                if not isinstance(base, str) or not base:
                    self.report(
                        "ERROR", relative, f"repositories.{name}.base must be a non-empty string"
                    )
        agent = config.get("agent")
        if not isinstance(agent, dict):
            self.report("ERROR", relative, "agent must be a mapping")
        else:
            for key in (
                "max_concurrent_agents",
                "max_turns",
                "max_retry_backoff_ms",
                "timeout_seconds",
            ):
                value = agent.get(key)
                if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
                    self.report("ERROR", relative, f"agent.{key} must be a positive integer")
            command = agent.get("command")
            cli_wrapper = agent.get("cli_wrapper")
            if command is not None and cli_wrapper is not None:
                self.report(
                    "ERROR",
                    relative,
                    "agent.cli_wrapper and agent.command are mutually exclusive",
                )
            if cli_wrapper is not None and cli_wrapper != "codex":
                self.report("ERROR", relative, "agent.cli_wrapper must currently be 'codex'")
            if command is not None and (
                not isinstance(command, list)
                or not command
                or not all(isinstance(item, str) and item for item in command)
            ):
                self.report(
                    "ERROR",
                    relative,
                    "agent.command must be a non-empty list of command arguments",
                )
            if not isinstance(agent.get("wrapper_options", {}), dict):
                self.report("ERROR", relative, "agent.wrapper_options must be a mapping")
        polling = config.get("polling")
        interval = polling.get("interval_ms") if isinstance(polling, dict) else None
        if not isinstance(interval, int) or isinstance(interval, bool) or interval <= 0:
            self.report("ERROR", relative, "polling.interval_ms must be a positive integer")
        if isinstance(polling, dict):
            max_retries = polling.get("max_retries", 3)
            if (
                not isinstance(max_retries, int)
                or isinstance(max_retries, bool)
                or max_retries < 0
            ):
                self.report(
                    "ERROR", relative, "polling.max_retries must be a non-negative integer"
                )
            if not positive_integer(polling.get("retry_initial_ms", 1000)):
                self.report(
                    "ERROR", relative, "polling.retry_initial_ms must be a positive integer"
                )
            elif (
                isinstance(agent, dict)
                and positive_integer(agent.get("max_retry_backoff_ms"))
                and polling.get("retry_initial_ms", 1000) > agent["max_retry_backoff_ms"]
            ):
                self.report(
                    "ERROR",
                    relative,
                    "polling.retry_initial_ms must not exceed agent.max_retry_backoff_ms",
                )
        tracker = config.get("tracker")
        if not isinstance(tracker, dict) or not isinstance(tracker.get("pack"), str):
            self.report("ERROR", relative, "tracker.pack must be a string")
        else:
            joint = tracker.get("joint")
            if joint is not None and (
                not isinstance(joint, list)
                or not joint
                or not all(isinstance(item, str) and item for item in joint)
            ):
                self.report(
                    "ERROR", relative, "tracker.joint must be a non-empty list of command arguments"
                )
            if not positive_integer(tracker.get("joint_timeout_seconds", 30)):
                self.report(
                    "ERROR", relative, "tracker.joint_timeout_seconds must be a positive integer"
                )
            if any(
                not isinstance(tracker.get(key), list)
                or not all(isinstance(item, str) for item in tracker[key])
                for key in ("required_labels", "active_states", "terminal_states")
            ):
                self.report(
                    "ERROR", relative, "tracker state and label settings must be lists of strings"
                )
            if tracker.get("pack") in {
                "daik.tracker.github-issues",
                "daik.tracker.beads",
            } and ("adapter" in tracker or "command" in tracker):
                self.report(
                    "ERROR",
                    relative,
                    "tracker access must be user-configured in daik-tracker.md, not as a tracker command",
                )

    def validate_manifest(
        self, manifest: dict[str, Any], workflow: dict[str, Any], tracker: dict[str, Any]
    ) -> None:
        relative = ".daik/manifest.json"
        if manifest.get("schema_version") != 1 or manifest.get("tool") != "daik":
            self.report("ERROR", relative, "unsupported or invalid manifest")
        packs = manifest.get("packs")
        selected: dict[str, str] = {}
        if not isinstance(packs, list):
            self.report("ERROR", relative, "packs must be a list")
        else:
            for pack in packs:
                if isinstance(pack, dict) and isinstance(pack.get("kind"), str) and isinstance(pack.get("id"), str):
                    selected[pack["kind"]] = pack["id"]
                else:
                    self.report("ERROR", relative, "each pack must have string kind and id")
        for kind, metadata, key in (
            ("workflow", workflow, "workflow_pack"),
            ("tracker", tracker, "tracker_pack"),
        ):
            if metadata and selected.get(kind) != metadata.get(key):
                self.report("ERROR", relative, f"selected {kind} pack does not match {key}")
        language = manifest.get("language")
        for path, metadata in (("workflow", workflow), ("tracker", tracker)):
            if metadata and metadata.get("language") != language:
                self.report("ERROR", relative, f"language does not match {path} document")
        files = manifest.get("files")
        if not isinstance(files, dict):
            self.report("ERROR", relative, "files must be a mapping")
            return
        for name, record in files.items():
            if not isinstance(name, str) or not isinstance(record, dict):
                self.report("ERROR", relative, "invalid file record")
                continue
            path = self.root / name
            if not path.is_file():
                self.report("ERROR", name, "file recorded in manifest is missing")
                continue
            expected_hash = record.get("template_sha256")
            owner = record.get("owner")
            if not isinstance(expected_hash, str) or owner not in {"user", "daik"}:
                self.report("ERROR", relative, f"invalid manifest record for {name}")
                continue
            modified = sha256_file(path) != expected_hash
            if modified and owner == "daik":
                self.report("ERROR", name, "daik-owned file differs from its recorded template")
            elif modified:
                self.report("INFO", name, "user-owned file has been customized")


def validate_site(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    diagnostics = SiteValidator(root).validate()
    order = {"ERROR": 0, "WARNING": 1, "INFO": 2}
    for diagnostic in sorted(diagnostics, key=lambda item: (order[item.severity], item.path, item.message)):
        print(f"{diagnostic.severity} {diagnostic.path}: {diagnostic.message}")
    counts = {severity: sum(item.severity == severity for item in diagnostics) for severity in order}
    result = "failed" if counts["ERROR"] else "passed"
    print(
        f"Validation {result}: {counts['ERROR']} error(s), "
        f"{counts['WARNING']} warning(s), {counts['INFO']} info message(s)"
    )
    return 1 if counts["ERROR"] else 0


def command_result(command: list[str], timeout: int = 10) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def discover_git_checkouts(root: Path, workspace_root: Path | None) -> list[Path]:
    """Find checkout markers without reading repository contents."""
    found: list[Path] = []
    excluded = {root / ".agents", root / ".daik"}
    if workspace_root is not None:
        excluded.add(workspace_root)
    for current_name, directories, files in os.walk(root, followlinks=False):
        current = Path(current_name)
        has_git_marker = ".git" in directories or ".git" in files
        directories[:] = [
            name
            for name in directories
            if name != ".git" and current / name not in excluded
        ]
        if has_git_marker:
            found.append(current)
            if current != root:
                directories[:] = []
    return sorted(found)


def doctor_site(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")

    diagnostics = SiteValidator(root).validate()
    config: dict[str, Any] | None = None
    config_path = root / ".agents/daik-config.yaml"
    if config_path.is_file():
        try:
            config = parse_yaml_subset(config_path)
        except (DaikError, OSError):
            pass  # SiteValidator already reports this error.

    git = shutil.which("git")
    if git is None:
        diagnostics.append(Diagnostic("ERROR", "git", "executable was not found on PATH"))
    else:
        version = command_result([git, "--version"])
        if version is None or version.returncode != 0:
            diagnostics.append(Diagnostic("ERROR", "git", "executable could not be run"))
        else:
            detail = version.stdout.strip() or "available"
            diagnostics.append(Diagnostic("INFO", "git", detail))

    workspace_path: Path | None = None
    if config is not None:
        workspace = config.get("workspace")
        workspace_name = workspace.get("root") if isinstance(workspace, dict) else None
        if isinstance(workspace_name, str):
            candidate = Path(workspace_name)
            if not candidate.is_absolute() and ".." not in candidate.parts:
                workspace_path = root / candidate
                if workspace_path.is_dir():
                    try:
                        with tempfile.TemporaryFile(dir=workspace_path):
                            pass
                    except OSError as error:
                        diagnostics.append(
                            Diagnostic("ERROR", workspace_name, f"directory is not writable: {error}")
                        )
                    else:
                        diagnostics.append(
                            Diagnostic("INFO", workspace_name, "workspace directory is writable")
                        )

    checkouts = discover_git_checkouts(root, workspace_path)
    site_git = command_result([git, "-C", str(root), "rev-parse", "--show-toplevel"]) if git else None
    site_is_repository = site_git is not None and site_git.returncode == 0
    if checkouts:
        diagnostics.append(
            Diagnostic("INFO", ".", f"found {len(checkouts)} Git checkout(s) outside workspaces")
        )
    elif site_is_repository:
        diagnostics.append(Diagnostic("INFO", ".", "site is managed as a Git repository"))
    else:
        diagnostics.append(
            Diagnostic("WARNING", ".", "no Git checkout was found outside workspaces")
        )

    tracker_pack = None
    if config is not None and isinstance(config.get("tracker"), dict):
        tracker_pack = config["tracker"].get("pack")
    if tracker_pack == "daik.tracker.github-issues":
        diagnostics.append(
            Diagnostic(
                "INFO",
                "tracker",
                "run the daik-check-github-issues-compatibility skill when compatibility verification is required",
            )
        )
    elif tracker_pack == "daik.tracker.beads":
        diagnostics.append(
            Diagnostic(
                "INFO",
                "tracker",
                "run the daik-check-beads-compatibility skill when compatibility verification is required",
            )
        )
    tracker_settings = config.get("tracker") if isinstance(config, dict) else None
    tracker_joint = (
        tracker_settings.get("joint") if isinstance(tracker_settings, dict) else None
    )
    if not isinstance(tracker_joint, list) or not tracker_joint:
        diagnostics.append(
            Diagnostic(
                "WARNING",
                "tracker",
                "tracker.joint is not configured; work run is unavailable",
            )
        )
    elif shutil.which(tracker_joint[0]) is None:
        diagnostics.append(
            Diagnostic(
                "ERROR",
                "tracker",
                f"joint executable was not found on PATH: {tracker_joint[0]}",
            )
        )
    else:
        diagnostics.append(
            Diagnostic(
                "INFO",
                "tracker",
                f"tracker joint command is available: {tracker_joint[0]}",
            )
        )
    agent_settings = config.get("agent") if isinstance(config, dict) else None
    agent_command = agent_settings.get("command") if isinstance(agent_settings, dict) else None
    cli_wrapper = agent_settings.get("cli_wrapper") if isinstance(agent_settings, dict) else None
    if cli_wrapper == "codex":
        codex = shutil.which("codex")
        if codex is None:
            diagnostics.append(Diagnostic("ERROR", "agent", "codex executable was not found on PATH"))
        else:
            diagnostics.append(Diagnostic("INFO", "agent", f"Codex CLI wrapper is configured: {codex}"))
    elif not isinstance(agent_command, list) or not agent_command:
        diagnostics.append(
            Diagnostic(
                "WARNING",
                "agent",
                "agent.cli_wrapper or agent.command is not configured; work agent run is unavailable",
            )
        )
    elif shutil.which(agent_command[0]) is None:
        diagnostics.append(
            Diagnostic("ERROR", "agent", f"executable was not found on PATH: {agent_command[0]}")
        )
    else:
        diagnostics.append(
            Diagnostic("INFO", "agent", f"coding-agent command is available: {agent_command[0]}")
        )

    order = {"ERROR": 0, "WARNING": 1, "INFO": 2}
    for diagnostic in sorted(diagnostics, key=lambda item: (order[item.severity], item.path, item.message)):
        print(f"{diagnostic.severity} {diagnostic.path}: {diagnostic.message}")
    counts = {severity: sum(item.severity == severity for item in diagnostics) for severity in order}
    result = "failed" if counts["ERROR"] else "passed"
    print(
        f"Doctor {result}: {counts['ERROR']} error(s), "
        f"{counts['WARNING']} warning(s), {counts['INFO']} info message(s)"
    )
    return 1 if counts["ERROR"] else 0


def load_site_config(root: Path) -> dict[str, Any]:
    path = root / ".agents/daik-config.yaml"
    if not path.is_file():
        raise DaikError(f"required configuration is missing: {path}")
    return parse_yaml_subset(path)


def workspace_manager(args: argparse.Namespace) -> WorkspaceManager:
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise DaikError(f"site root is not a directory: {root}")
    try:
        return WorkspaceManager(root, load_site_config(root))
    except WorkspaceError as error:
        raise DaikError(str(error)) from error


def work_workspace_create(args: argparse.Namespace) -> int:
    try:
        result = workspace_manager(args).create(args.issue, args.repo)
    except WorkspaceError as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
    return 0


def work_workspace_show(args: argparse.Namespace) -> int:
    try:
        result = workspace_manager(args).inspect(args.issue, args.repo)
    except WorkspaceError as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
    return 0


def work_workspace_list(args: argparse.Namespace) -> int:
    try:
        result = workspace_manager(args).list()
    except WorkspaceError as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
    return 0


def work_workspace_reconcile(args: argparse.Namespace) -> int:
    try:
        content = sys.stdin.read() if args.event == "-" else Path(args.event).read_text(encoding="utf-8")
        expected = json.loads(content)
        if not isinstance(expected, dict):
            raise WorkspaceError("expected event root must be an object")
        result, compatible = workspace_manager(args).reconcile(args.issue, expected)
    except (WorkspaceError, json.JSONDecodeError, OSError) as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
    return 0 if compatible else 1


def work_workspace_remove(args: argparse.Namespace) -> int:
    try:
        result = workspace_manager(args).remove(args.issue, args.repo, args.wet_run)
    except WorkspaceError as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
    if not args.wet_run:
        print("Preview only: run again with --wet-run to remove worktrees", file=sys.stderr)
    return 0


def work_handoff_create(args: argparse.Namespace) -> int:
    try:
        result = handoff_event(
            args.issue,
            args.from_role,
            args.to_role,
            args.phase,
            args.summary,
            args.commit,
            args.validation,
            args.decision,
            args.risk,
            args.next_action,
        )
    except WorkspaceError as error:
        raise DaikError(str(error)) from error
    print(dump_event(result))
