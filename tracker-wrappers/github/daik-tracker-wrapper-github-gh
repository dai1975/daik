#!/usr/bin/env python3
"""GitHub Issues tracker wrapper backed by GitHub CLI."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Any, Sequence


REQUEST_PROTOCOL = "daik.tracker-wrapper.v1"
RESULT_PROTOCOL = "daik.tracker-wrapper-result.v1"
EVENT_MARKER = "<!-- daik:issue-event:v1 -->"
EVENT_PATTERN = re.compile(
    r"<!-- daik:issue-event:v1 -->\s*```json\s*(.*?)\s*```", re.DOTALL
)
ISSUE_PATTERN = re.compile(r"^github:([^#]+)#([1-9][0-9]*)$")
CLOSE_REASONS = {
    "completed": "completed",
    "duplicate": "not planned",
    "superseded": "not planned",
    "cancelled": "not planned",
}


class WrapperFailure(RuntimeError):
    pass


def response(status: str, **values: Any) -> dict[str, Any]:
    return {"protocol_version": RESULT_PROTOCOL, "status": status, **values}


class GitHubTrackerWrapper:
    def __init__(
        self,
        repository_paths: dict[str, Path],
        repositories: dict[str, str],
        required_labels: Sequence[str],
        gh: str,
    ):
        self.repository_paths = repository_paths
        self.repositories = dict(repositories)
        self.required_labels = set(required_labels)
        self.gh = gh

    def run_gh(
        self,
        arguments: Sequence[str],
        cwd: Path | None = None,
        json_output: bool = True,
    ) -> Any:
        try:
            result = subprocess.run(
                [self.gh, *arguments],
                cwd=cwd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
        except OSError as error:
            raise WrapperFailure(f"could not start gh: {error}") from error
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or "gh command failed"
            raise WrapperFailure(detail[-2000:])
        if not json_output:
            return result.stdout.strip() or None
        if not result.stdout.strip():
            return None
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise WrapperFailure(f"gh returned invalid JSON: {result.stdout[-1000:]}") from error

    def resolve_repositories(self) -> None:
        for key, path in self.repository_paths.items():
            value = self.run_gh(["repo", "view", "--json", "nameWithOwner"], cwd=path)
            name = value.get("nameWithOwner") if isinstance(value, dict) else None
            if not isinstance(name, str) or "/" not in name:
                raise WrapperFailure(f"gh did not resolve a GitHub repository for {key}: {path}")
            self.repositories[key] = name
        if not self.repositories:
            raise WrapperFailure("no GitHub repositories are configured")

    def parse_issue(self, value: Any) -> tuple[str, str, int]:
        if not isinstance(value, str):
            raise WrapperFailure("issue must be a string")
        match = ISSUE_PATTERN.fullmatch(value)
        if match is None:
            raise WrapperFailure("issue must use github:<repository-key>#<number>")
        key, number_text = match.groups()
        repository = self.repositories.get(key)
        if repository is None:
            raise WrapperFailure(f"unknown GitHub repository key: {key}")
        return key, repository, int(number_text)

    @staticmethod
    def label_names(issue: dict[str, Any]) -> set[str]:
        labels = issue.get("labels", [])
        return {
            item["name"]
            for item in labels
            if isinstance(item, dict) and isinstance(item.get("name"), str)
        }

    @staticmethod
    def extract_events(issue: dict[str, Any]) -> list[dict[str, Any]]:
        events: list[dict[str, Any]] = []
        for comment in issue.get("comments", []):
            body = comment.get("body") if isinstance(comment, dict) else None
            if not isinstance(body, str):
                continue
            for encoded in EVENT_PATTERN.findall(body):
                try:
                    event = json.loads(encoded)
                except json.JSONDecodeError:
                    continue
                if isinstance(event, dict) and event.get("schema") == "daik.issue-event.v1":
                    events.append(event)
        return events

    @staticmethod
    def control_version(events: list[dict[str, Any]]) -> str:
        encoded = json.dumps(events, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        return hashlib.sha256(encoded.encode("utf-8")).hexdigest()

    def view(self, repository: str, number: int) -> dict[str, Any]:
        value = self.run_gh(
            [
                "issue", "view", str(number), "--repo", repository,
                "--json", "assignees,comments,labels,state",
            ]
        )
        if not isinstance(value, dict):
            raise WrapperFailure("gh issue view did not return an object")
        return value

    def list_ready(self, request: dict[str, Any]) -> dict[str, Any]:
        limit = request.get("limit")
        exclude = request.get("exclude", [])
        if not isinstance(limit, int) or isinstance(limit, bool) or limit <= 0:
            raise WrapperFailure("limit must be a positive integer")
        if not isinstance(exclude, list) or not all(isinstance(item, str) for item in exclude):
            raise WrapperFailure("exclude must be a list of strings")
        excluded = set(exclude)
        ready: list[str] = []
        query_limit = max(100, limit * 10)
        for key, repository in self.repositories.items():
            value = self.run_gh(
                [
                    "issue", "list", "--repo", repository, "--state", "open",
                    "--limit", str(query_limit), "--json", "blockedBy,labels,number",
                ]
            )
            if not isinstance(value, list):
                raise WrapperFailure("gh issue list did not return a list")
            for issue in value:
                if not isinstance(issue, dict) or not isinstance(issue.get("number"), int):
                    continue
                issue_id = f"github:{key}#{issue['number']}"
                labels = self.label_names(issue)
                blocked_by = issue.get("blockedBy", [])
                unresolved = any(
                    not isinstance(item, dict) or str(item.get("state", "OPEN")).upper() != "CLOSED"
                    for item in blocked_by
                ) if isinstance(blocked_by, list) else True
                eligible = self.required_labels <= labels or "daik:running" in labels
                if (
                    eligible
                    and "daik:blocked" not in labels
                    and "daik:status:blocked" not in labels
                    and not unresolved
                    and issue_id not in excluded
                ):
                    ready.append(issue_id)
                    if len(ready) == limit:
                        return response("ok", issues=ready)
        return response("ok", issues=ready)

    def read_control(self, request: dict[str, Any]) -> dict[str, Any]:
        _, repository, number = self.parse_issue(request.get("issue"))
        events = self.extract_events(self.view(repository, number))
        return response("ok", control_version=self.control_version(events), events=events)

    def ensure_label(self, repository: str, name: str) -> None:
        labels = self.run_gh(["label", "list", "--repo", repository, "--limit", "1000", "--json", "name"])
        if isinstance(labels, list) and any(
            isinstance(item, dict) and item.get("name") == name for item in labels
        ):
            return
        self.run_gh(
            [
                "label", "create", name, "--repo", repository,
                "--color", "1D76DB", "--description", "daik workflow control",
            ],
            json_output=False,
        )

    def replace_label_namespace(
        self, repository: str, number: int, labels: set[str], prefix: str, target: str
    ) -> None:
        arguments = ["issue", "edit", str(number), "--repo", repository]
        for name in sorted(item for item in labels if item.startswith(prefix) and item != target):
            arguments.extend(("--remove-label", name))
        if target not in labels:
            self.ensure_label(repository, target)
            arguments.extend(("--add-label", target))
        if len(arguments) > 6:
            self.run_gh(arguments, json_output=False)

    def commit_control(self, request: dict[str, Any]) -> dict[str, Any]:
        _, repository, number = self.parse_issue(request.get("issue"))
        expected = request.get("expected_control_version")
        events = request.get("events")
        if not isinstance(expected, str):
            raise WrapperFailure("expected_control_version must be a string")
        if not isinstance(events, list) or not all(isinstance(item, dict) for item in events):
            raise WrapperFailure("events must be a list of objects")
        issue = self.view(repository, number)
        previous = self.extract_events(issue)
        if self.control_version(previous) != expected:
            return response("conflict", message="GitHub Issue control events changed")

        claim = request.get("claim", False)
        if not isinstance(claim, bool):
            raise WrapperFailure("claim must be a boolean")
        if claim:
            user_data = self.run_gh(["api", "user"])
            user = user_data.get("login") if isinstance(user_data, dict) else None
            if not isinstance(user, str) or not user:
                raise WrapperFailure("gh did not return the authenticated login")
            assignees = {
                item["login"]
                for item in issue.get("assignees", [])
                if isinstance(item, dict) and isinstance(item.get("login"), str)
            }
            if assignees - {user}:
                return response("conflict", message="GitHub Issue is assigned to another actor")
            if user not in assignees:
                self.run_gh(
                    ["issue", "edit", str(number), "--repo", repository, "--add-assignee", "@me"],
                    json_output=False,
                )

        encoded_events: list[str] = []
        for event in events:
            if event.get("schema") != "daik.issue-event.v1" or event.get("issue") != request.get("issue"):
                raise WrapperFailure("every event must be a daik.issue-event.v1 object for this issue")
            encoded_events.append(
                EVENT_MARKER + "\n```json\n" + json.dumps(
                    event, ensure_ascii=False, sort_keys=True, indent=2
                ) + "\n```"
            )
        if encoded_events:
            self.run_gh(
                [
                    "issue", "comment", str(number), "--repo", repository,
                    "--body", "\n\n".join(encoded_events),
                ],
                json_output=False,
            )

        labels = self.label_names(issue)
        status = request.get("status")
        if status is not None:
            if not isinstance(status, str) or not status:
                raise WrapperFailure("status must be a non-empty string")
            target = f"daik:status:{status}"
            self.replace_label_namespace(repository, number, labels, "daik:status:", target)
            labels = {item for item in labels if not item.startswith("daik:status:")} | {target}

        if claim:
            self.ensure_label(repository, "daik:running")
            arguments = [
                "issue", "edit", str(number), "--repo", repository,
                "--add-label", "daik:running",
            ]
            if "daik:ready" in labels:
                arguments.extend(("--remove-label", "daik:ready"))
            self.run_gh(arguments, json_output=False)

        close_reason = request.get("close_reason")
        if close_reason is not None:
            if close_reason not in CLOSE_REASONS:
                raise WrapperFailure("unsupported close_reason")
            target = f"daik:close-reason:{close_reason}"
            self.replace_label_namespace(
                repository, number, labels, "daik:close-reason:", target
            )
            self.run_gh(
                [
                    "issue", "close", str(number), "--repo", repository,
                    "--reason", CLOSE_REASONS[close_reason],
                ],
                json_output=False,
            )

        updated = previous + events
        return response("ok", control_version=self.control_version(updated))

    def handle(self, request: Any) -> dict[str, Any]:
        if not isinstance(request, dict):
            raise WrapperFailure("request root must be an object")
        if request.get("protocol_version") != REQUEST_PROTOCOL:
            raise WrapperFailure(f"protocol_version must be {REQUEST_PROTOCOL}")
        operation = request.get("operation")
        if operation == "work.list_ready":
            return self.list_ready(request)
        if operation == "issue.read_control":
            return self.read_control(request)
        if operation == "issue.commit_control":
            return self.commit_control(request)
        raise WrapperFailure(f"unsupported operation: {operation}")


def key_value(value: str) -> tuple[str, str]:
    key, separator, item = value.partition("=")
    if not separator or not key or not item:
        raise argparse.ArgumentTypeError("expected KEY=VALUE")
    return key, item


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository-path", action="append", default=[], type=key_value)
    parser.add_argument("--repository", action="append", default=[], type=key_value)
    parser.add_argument("--required-label", action="append", default=[])
    parser.add_argument("--gh", default="gh")
    args = parser.parse_args()
    wrapper = GitHubTrackerWrapper(
        {key: Path(value).resolve() for key, value in args.repository_path},
        dict(args.repository),
        args.required_label,
        args.gh,
    )
    try:
        wrapper.resolve_repositories()
        request = json.load(sys.stdin)
        result = wrapper.handle(request)
    except (WrapperFailure, json.JSONDecodeError, OSError) as error:
        result = response("error", message=str(error))
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
